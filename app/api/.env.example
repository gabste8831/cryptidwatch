# Copie para .env para rodar local (npm run dev) com o docker compose da raiz.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
COOKIE_SECURE=false

# Gere um segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-bytes

DATABASE_URL=postgres://cryptidwatch:cryptidwatch@localhost:5433/cryptidwatch

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_AUTH_TOKEN=redis-local-dev

S3_BUCKET=cryptidwatch-fotos
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

SEED_MODERATOR_EMAIL=moderador@cryptidwatch.local
SEED_MODERATOR_PASSWORD=troque-esta-senha

# Em produção (EKS), os segredos vêm do Secrets Manager:
# APP_SECRET_ID=cryptidwatch/app
# DB_SSL=true
# DB_SSL_CA_FILE=/app/certs/rds-global-bundle.pem
# REDIS_TLS=true
# TRUST_PROXY=1
